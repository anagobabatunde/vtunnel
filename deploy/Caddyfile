# VTunnel Caddy Reverse Proxy — tunnel.vtunnel.io
#
# Caddy handles TLS termination (including wildcard certs via DNS-01)
# and forwards visitor traffic to vtunnel's HTTP proxy on localhost.
#
# Tunnel clients connect directly to vtunnel on :8080 (not through Caddy).
#
# Prerequisites:
#   1. DNS A records (Cloudflare, DNS-only / grey cloud):
#      tunnel.vtunnel.io    -> VPS_IP
#      *.tunnel.vtunnel.io  -> VPS_IP
#   2. Install caddy with cloudflare DNS plugin:
#      xcaddy build --with github.com/caddy-dns/cloudflare
#   3. Set CF_API_TOKEN in Caddy's systemd environment

# Wildcard subdomain routing (visitor traffic)
*.tunnel.vtunnel.io {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    reverse_proxy localhost:8081
}

# Base domain (health checks / landing page)
tunnel.vtunnel.io {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    reverse_proxy localhost:8081
}
